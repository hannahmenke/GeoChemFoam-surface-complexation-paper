TITLE Sr2+/Ca2+ competitive sorption - HM12 resolved-wall benchmark
# Legacy resolved-wall benchmark corresponding to the DBS solid-only HM12 case.

SURFACE_MASTER_SPECIES
    Surf_a Surf_aH

SURFACE_SPECIES
    Surf_aH = Surf_aH
    Surf_aH = Surf_a- + H+
        -log_k -7.9
        -mole_balance Surf_a-
    Surf_aH + Ca+2 = Surf_aCa+ + H+
        -log_k -5.85
        -mole_balance Surf_aCa+
    Surf_aH + Sr+2 = Surf_aSr+ + H+
        -log_k -5.5
        -mole_balance Surf_aSr+

SOLUTION 0 limestone formation water (1 mM Ca2+)
    units   mol/L
    Ca      1e-3
    Sr      1e-12
    Cl      2e-3
    pH      7 charge

SOLUTION 1 formation water for surface pre-equilibration
    units   mol/L
    Ca      1e-3
    Sr      1e-12
    Cl      2e-3
    pH      7 charge

SELECTED_OUTPUT
    -molalities Surf_a- Surf_aCa+ Surf_aSr+ Surf_aH
    -ionic_strength true

USER_PUNCH
    -headings psi
    -start
    10 PUNCH SURF("Surf_a","psi")
    -end

END

