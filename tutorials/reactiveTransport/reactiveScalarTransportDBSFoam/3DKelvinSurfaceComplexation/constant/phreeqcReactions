TITLE Zn2+/Ca2+ competitive sorption on generic surface sites

SURFACE_MASTER_SPECIES
    Surf_a Surf_aH

SURFACE_SPECIES
    Surf_aH = Surf_aH
    Surf_aH = Surf_a- + H+
        -log_k -7.9
        -mole_balance Surf_a-
    Surf_aH + Ca+2 = Surf_aCa+ + H+
        -log_k -5.85
        -mole_balance Surf_aCa+
    Surf_aH + Zn+2 = Surf_aZn+ + H+
        -log_k -4.0
        -mole_balance Surf_aZn+

SOLUTION 0 background water with trace Ca and Zn
    units   mol/L
    Ca      1e-12
    Zn      1e-12
    Cl      1e-12
    pH      7 charge

SOLUTION 1 initial surface equilibration state
    units   mol/L
    Ca      1e-12
    Zn      1e-12
    Cl      1e-12
    pH      7 charge

SELECTED_OUTPUT
    -molalities Surf_a- Surf_aCa+ Surf_aZn+ Surf_aH
    -ionic_strength true

USER_PUNCH
    -headings psi
    -start
    10 PUNCH SURF("Surf_a","psi")
    -end

END
