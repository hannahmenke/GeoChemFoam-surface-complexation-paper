FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      theta;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 0.5;

boundaryField
{
    walls
    {
        type            zeroGradient;
    }
    inlet
    {
        type            zeroGradient;
        value           uniform 0.5;
    }
    outlet
    {
        type            zeroGradient;
    }

    fixedWalls
    {
        type           zeroGradient;
    }

    frontandback
    {
        type            empty;
    }

}

